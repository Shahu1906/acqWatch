# AcqWatch Frontend Environment Configuration
# Copy this file to .env and set your values.

# AcqWatch Python Backend URL (FastAPI server)
# Default: proxied through Vite dev server (no need to change for local dev)
# For production deployment, set to the full backend URL:
VITE_API_BASE_URL=http://127.0.0.1:8080

# Enable mock/demo mode (true = show demo data without backend; false = require live backend)
# WARNING: Mock mode is explicitly labeled in the UI and never presented as live data.
VITE_MOCK_MODE=false
