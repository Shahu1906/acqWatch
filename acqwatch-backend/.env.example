# AcqWatch Backend Environment Configuration
# Copy to .env and edit as needed. Never commit .env to source control.

# Path to the existing SQLite database (relative to acqwatch-backend/ or absolute)
DB_PATH=data/land_delays.db

# Path to the trained Gradient Boosting model artifact
MODEL_PATH=models/gradient_boosting.joblib

# Path to the existing src/ package (needed to import FeaturePipeline, RiskEngine, etc.)
EXISTING_SRC_PATH=.

# CORS origins (comma-separated). Use * for development only.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Server settings
HOST=127.0.0.1
PORT=8080

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Maximum export rows per request
MAX_EXPORT_ROWS=5000

# Maximum page size
MAX_PAGE_SIZE=500
